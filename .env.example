# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Load it with:  set -a; . ./.env; set +a   (or `docker run --env-file .env ...`)

# --- Storage (required) -----------------------------------------------------
# Hugging Face Storage Bucket that holds every file, as "owner/name".
HF_BUCKET_ID=your-username/your-cdn-bucket
# Hugging Face access token with WRITE permission to that bucket.
HF_TOKEN=
# Set to 1 to create the bucket as private if it doesn't exist yet.
HF_BUCKET_PRIVATE=0

# --- Public URLs ------------------------------------------------------------
# Where the web UI is served, and the host that serves raw files.
CDN_BASE_URL=http://localhost:8000
RAW_DOMAIN=raw.localhost
RAW_BASE_URL=http://raw.localhost:8000

# --- GitHub Actions sync (/api/gh-sync) -------------------------------------
# Must equal the audience your workflows pass to core.getIDToken(...).
# Use your own CDN hostname when self-hosting.
OIDC_AUDIENCE=cdn.example.com
# Comma-separated GitHub owners that may sync without manual approval.
GH_ALWAYS_ALLOW=your-github-username

# --- Admin dashboard (/admin) -----------------------------------------------
# Leave ADMIN_TOKEN unset to switch the dashboard, IP bans and the GitHub
# allowlist off entirely.
ADMIN_TOKEN=
# Encrypts the saved admin state in the bucket. Set it separately so rotating
# ADMIN_TOKEN doesn't lock you out of that state. Falls back to ADMIN_TOKEN.
ADMIN_DATA_KEY=

# --- Upload guard -----------------------------------------------------------
# Refuse uploads from VPN/proxy IPs (1 = on).
VPN_BLOCK=1
# Allow the upload anyway if the VPN lookup itself fails (1 = allow).
VPN_FAIL_OPEN=1
# Optional proxycheck.io key for the VPN lookup.
PROXYCHECK_KEY=
# Comma-separated IPs that are never VPN-blocked.
VPN_ALLOWLIST=

# --- Client IP detection (rate limits and bans depend on this) --------------
# Behind Cloudflare, set to 1 to trust the CF-Connecting-IP header.
TRUST_CF_CONNECTING_IP=0
# Number of trusted reverse proxies in front of the app (X-Forwarded-For hops).
TRUSTED_PROXY_HOPS=1
